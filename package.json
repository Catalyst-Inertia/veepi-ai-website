{
  "name": "house-of-suntory",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "yarn style-init && yarn style-init-tailwind && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prepare": "husky",
    "style-init": "tsx src/script/generate-sass-variable.ts",
    "style-init-tailwind": "tsx src/script/generate-tailwind-variable.ts",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:down": "payload migrate:down",
    "migrate:status": "payload migrate:status",
    "migrate:refresh": "payload migrate:refresh",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "format": "yarn prettier --write ."
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.0.1",
    "@gsap/react": "^2.1.2",
    "@next/third-parties": "^16.3.4",
    "@payloadcms/db-mongodb": "3.87.0",
    "@payloadcms/live-preview": "3.87.0",
    "@payloadcms/live-preview-react": "3.87.0",
    "@payloadcms/next": "3.87.0",
    "@payloadcms/richtext-lexical": "3.87.0",
    "@payloadcms/storage-s3": "3.87.0",
    "@payloadcms/ui": "3.87.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@tanstack/react-query": "^5.81.5",
    "antd": "^5.22.1",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "dotenv": "^17.0.0",
    "framer-motion": "^11.3.2",
    "graphql": "^17.0.2",
    "gsap": "^3.14.2",
    "lottie-react": "^2.4.1",
    "next": "^15.3.6",
    "payload": "3.87.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sass": "^1.77.8",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^8",
    "eslint-config-next": "^15.3.4",
    "husky": "^9.0.11",
    "postcss": "^8.5.6",
    "prettier": "^3.3.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5"
  }
}
